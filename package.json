{
  "name": "mealo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:demo": "npm run sqlite:copy && VITE_DEMO=1 vite --port 5174 --strictPort",
    "build:demo": "npm run sqlite:copy && tsc -b && VITE_DEMO=1 vite build --outDir dist-demo && cp worker/demo-ai.js dist-demo/_worker.js && cp worker/demo-routes.json dist-demo/_routes.json",
    "deploy:demo": "node scripts/deploy-demo.mjs",
    "sqlite:copy": "node scripts/copy-sqlite.mjs",
    "predev": "npm run sqlite:copy",
    "prebuild": "npm run sqlite:copy",
    "prepreview": "npm run sqlite:copy",
    "check": "node scripts/check.mjs",
    "test:portions": "esbuild scripts/test-portions.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-portions.mjs --log-level=warning && node node_modules/.cache/test-portions.mjs",
    "test:safety": "esbuild scripts/test-safety.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-safety.mjs --log-level=warning && node node_modules/.cache/test-safety.mjs",
    "test": "npm run test:portions && npm run test:safety && npm run test:demo && npm run test:e2e",
    "test:demo": "node scripts/test-demo-ai.mjs",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:relay": "node scripts/test-relay.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "4.148.0"
  }
}
